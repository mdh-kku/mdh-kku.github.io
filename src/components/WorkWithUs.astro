---
import SectionHeading from './SectionHeading.astro';
import { mailtoHref } from '../lib/site';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section id="work-with-us" class="work">
  <div class="container">
    <SectionHeading label="Work with us" title="Collaborate, or fund what comes next" />
    <p class="lede">
      Clinical sites, researchers and universities: bring us a clinical question. Funders: back a project's next stage,
      such as SPEAK SPARK!'s clinical study.
    </p>
    <div class="actions">
      <a class="pill" href={mailtoHref(email, 'Collaboration with MDH Lab')}>Collaborate</a>
      <a class="pill pill--out" href={mailtoHref(email, 'Funding for MDH Lab')}>Fund a project</a>
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: 96px;
    margin-top: 72px;
    text-align: center;
    background: linear-gradient(180deg, var(--white) 0%, var(--fade-end) 100%);
  }

  .lede {
    max-width: 60ch;
    margin: 20px auto 0;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
</style>
