---
interface Props {
  email?: string;
  facebook?: string;
}

const { email, facebook } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>MDH Lab · Laboratory for Medicine, Data &amp; Health · Faculty of Medicine, Khon Kaen University, Khon Kaen, Thailand</p>
    {
      (facebook || email) && (
        <p class="links">
          {facebook && <a href={facebook} target="_blank" rel="noopener">The MSc on Facebook ↗</a>}
          {email && <a id="contact" href={`mailto:${email}`}>{email}</a>}
        </p>
      )
    }
    <p>© {year}</p>
  </div>
</footer>
