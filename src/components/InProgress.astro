---
import SectionHeading from './SectionHeading.astro';
import type { PersonView } from '../lib/content';
import { showSection, thesesHeadline } from '../lib/site';

interface Props {
  people: PersonView[];
}

const { people } = Astro.props;
---

{
  showSection(people.length) && (
    <section id="in-progress" class="container">
      <div class="head">
        <SectionHeading lead="In progress." sub={thesesHeadline(people.length)} />
        <a class="all" href="/people/">All people</a>
      </div>
      <div class="grid">
        {people.map((p) => (
          <a class="thesis" href={`/people/#${p.id}`}>
            <span class="label">Thesis</span>
            <h3>{p.thesisTopic}</h3>
            <p class="who">{p.name}</p>
            <p class="advisor">
              {p.advisors.length > 1 ? 'Advisors' : 'Advisor'}: {p.advisors.map((a) => a.label).join(', ')}
            </p>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  section {
    padding-block: 72px 24px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .all {
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 28px;
  }

  .thesis {
    display: block;
    padding: 20px;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  h3 {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .who {
    margin-top: 12px;
    font-size: 15px;
  }

  .advisor {
    color: var(--ink-2);
    font-size: 14px;
  }

  /* The whole card is a link, so lifting it is honest feedback. */
  @media (hover: hover) and (pointer: fine) {
    .thesis {
      transition: transform 200ms ease;
    }

    .thesis:hover {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thesis,
    .thesis:hover {
      transition: none;
      transform: none;
    }
  }
</style>
