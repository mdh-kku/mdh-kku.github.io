---
import SectionHeading from './SectionHeading.astro';
import type { UpdateView } from '../lib/content';
import { latestFirst } from '../lib/site';

interface Props {
  updates: UpdateView[];
}

const updates = latestFirst(Astro.props.updates);
const month = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).toUpperCase();
---

{
  updates.length > 0 && (
    <section id="latest" class="latest">
      <div class="container">
        <SectionHeading label="Latest" title="Awards and updates" />
        <ol class="list">
          {updates.map((u) => (
            <li>
              <span class="label">{month(u.date)}</span>
              <div>
                <h3>{u.title}</h3>
                <p>{u.detail}</p>
              </div>
              {u.sourceUrl && <a class="label source" href={u.sourceUrl}>Source ↗</a>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  /* Light rows on white, separated by hairlines. */
  .latest {
    padding-block: 88px 24px;
  }

  .list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: baseline;
    padding-block: 22px;
    border-top: 1px solid var(--line);
  }

  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  p {
    margin-top: 6px;
    color: var(--ink-2);
  }

  .source {
    color: var(--ink);
    text-underline-offset: 4px;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
