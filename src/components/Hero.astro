---
import { Image } from 'astro:assets';
import type { HeroPhoto } from '../lib/content';
import { heroPhotosToShow } from '../lib/site';

interface Props {
  photos: HeroPhoto[];
  hasContact: boolean;
  /** `#research` when the research-area slides show; the full research page otherwise, so it is never a dead link. */
  researchHref: string;
}

const { photos, hasContact, researchHref } = Astro.props;
// Four fixed slots near the edges; shapes follow the approved mockup.
const SHAPES = ['shape-circle', 'shape-pill', 'shape-arch', 'shape-square'];
const shown = heroPhotosToShow(photos);
---

<section class="hero">
  {
    shown.map((p, i) => (
      <div class:list={['hero-photo', SHAPES[i], { bw: !p.color }]}>
        <Image src={p.image} alt={p.alt} width={260} />
      </div>
    ))
  }
  <div class="container text">
    <p class="label">Faculty of Medicine · Khon Kaen University</p>
    <h1><span class="pre">Laboratory for</span> Medicine, <br />Data &amp; Health</h1>
    <div class="actions">
      <a class="pill" href={researchHref}>See our research</a>
      {hasContact && <a class="pill pill--out" href="#work-with-us">Work with us</a>}
    </div>
  </div>
</section>

<style>
  /* The sky is still on purpose: no slow looping motion. */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 96px 88px;
    text-align: center;
    background:
      radial-gradient(55% 75% at 22% 18%, var(--sky-2) 0%, transparent 62%),
      radial-gradient(45% 70% at 80% 28%, var(--sky-3) 0%, transparent 62%),
      radial-gradient(40% 60% at 60% 90%, var(--sky-4) 0%, transparent 60%),
      linear-gradient(180deg, var(--sky-1) 0%, var(--white) 92%);
  }

  .text {
    position: relative;
  }

  /* Two lines, centred as a block and aligned left. The vw size keeps the long line clear of the hero photos. */
  h1 {
    display: inline-block;
    margin: 20px auto 30px;
    font-size: clamp(2.75rem, 6.2vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: left;
    text-wrap: balance;
  }

  /* Phones break the name once, after "Medicine,". A real break keeps the block snug and centred. */
  @media (min-width: 540px) {
    h1 br {
      display: none;
    }
  }

  /* LIDS-style contrast: the formal part thin and small, the three words bold. */
  .pre {
    display: block;
    margin-bottom: 0.2em;
    color: var(--ink-2);
    font-size: 0.34em;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  /* Photos only where they can never overlap the name. */
  .hero-photo {
    display: none;
    position: absolute;
    overflow: hidden;
    box-shadow: 0 14px 30px rgba(20, 60, 140, 0.18);
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1200px) {
    .hero-photo {
      display: block;
    }
  }

  .shape-circle {
    top: 12%;
    left: 3%;
    width: 92px;
    height: 92px;
    border-radius: 50%;
  }

  .shape-pill {
    top: 58%;
    left: 5%;
    width: 124px;
    height: 80px;
    border-radius: 9999px;
  }

  .shape-arch {
    top: 8%;
    right: 3%;
    width: 104px;
    height: 126px;
    border-radius: 999px 999px 22px 22px;
  }

  .shape-square {
    top: 60%;
    right: 6%;
    width: 96px;
    height: 96px;
    border-radius: 30px;
  }
</style>
