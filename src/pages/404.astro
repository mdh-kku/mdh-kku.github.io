---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { loadSite } from '../lib/content';

const site = await loadSite();
---

<Base
  title="Page not found · MDH Lab"
  description="This page doesn't exist on the MDH Lab website."
  email={site.email}
  facebook={site.facebook}
>
  <div class="container page">
    <SectionHeading level={1} title="Page not found" />
    <p class="lede">It may have moved.</p>
    <a class="pill pill--out" href="/">Go to the home page →</a>
  </div>
</Base>

<style>
  .page {
    padding-block: 120px 160px;
  }

  .lede {
    margin-top: 12px;
    color: var(--ink-2);
  }

  .pill {
    margin-top: 28px;
  }
</style>
