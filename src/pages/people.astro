---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PersonTile from '../components/PersonTile.astro';
import { loadSite } from '../lib/content';
import { peopleCards, peopleLinkCss, showSection } from '../lib/site';

const site = await loadSite();
// Same launch rule as before: students show once there are at least 3; principal investigators from the first.
const cards = peopleCards(showSection(site.people.length) ? site.people : [], site.advisors);
---

<Base
  title="People · MDH Lab"
  description="Students and principal investigators of MDH Lab, Faculty of Medicine, Khon Kaen University."
  email={site.email}
  facebook={site.facebook}
>
  <div class="container page">
    <SectionHeading level={1} title="People" />
    {
      cards.length > 0 && (
        <ul class="people-grid">
          {cards.map((c, i) => (
            <li>
              <PersonTile card={c} level={2} index={i} expanded />
            </li>
          ))}
        </ul>
      )
    }
    <style is:inline set:html={peopleLinkCss(cards, '.people-grid')} />
  </div>
</Base>

<style>
  .page {
    padding-block: 56px 96px;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
