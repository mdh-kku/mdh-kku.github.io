---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import PublicationsFinder from '../components/PublicationsFinder.astro';
import Latest from '../components/Latest.astro';
import People from '../components/People.astro';
import WorkWithUs from '../components/WorkWithUs.astro';
import Goals from '../components/Goals.astro';
import Collaborators from '../components/Collaborators.astro';
import { loadSite } from '../lib/content';
import { showSection, visibleAreas } from '../lib/site';

const site = await loadSite();
const areasShown = showSection(visibleAreas(site.areas, site.projects, site.publications).length);
---

<Base
  title="MDH Lab · Laboratory for Medicine, Data & Health"
  description="A lab of medical students earning an MSc in Data Science and Health Informatics at the Faculty of Medicine, Khon Kaen University."
  email={site.email}
  facebook={site.facebook}
>
  <Hero photos={site.hero} hasContact={Boolean(site.email)} researchHref={areasShown ? '#research' : '/research/'} />
  <ResearchAreas areas={site.areas} projects={site.projects} publications={site.publications} />
  <PublicationsFinder publications={site.publications} areas={site.areas} />
  <People people={site.people} advisors={site.advisors} />
  <Latest updates={site.updates} />
  <Goals vision={site.vision} principles={site.principles} />
  <Collaborators collaborators={site.collaborators} />
  {site.email && <WorkWithUs email={site.email} />}
</Base>
