---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Latest from '../components/Latest.astro';
import { loadSite } from '../lib/content';

const site = await loadSite();
const hasContact = Boolean(site.email);
---

<Base
  title="MDH · Medical Data Science and Health Informatics"
  description="A lab of medical students earning an MSc in Data Science and Health Informatics at the Faculty of Medicine, Khon Kaen University."
  email={site.email}
>
  <Hero photos={site.hero} hasContact={hasContact} />
  <Projects projects={site.projects} />
  <Latest updates={site.updates} />
</Base>
